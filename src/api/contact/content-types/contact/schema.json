{
  "kind": "singleType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact Page",
    "description": "Contact page content with hero, contact methods, and form details"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroTitle": {
      "type": "string",
      "default": "Get in Touch"
    },
    "heroSubtitle": {
      "type": "string",
      "default": "We're Here to Help"
    },
    "heroDescription": {
      "type": "text",
      "default": "Have questions about our vehicles? Need support? Our team is ready to assist you."
    },
    "contactMethods": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-method"
    },
    "formTitle": {
      "type": "string",
      "default": "Send Us a Message"
    },
    "formDescription": {
      "type": "text",
      "default": "Fill out the form below and we'll get back to you within 24 hours"
    },
    "faqSectionTitle": {
      "type": "string",
      "default": "Quick Answers"
    },
    "faqSectionDescription": {
      "type": "text",
      "default": "Looking for immediate answers? Check out our FAQ section"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
