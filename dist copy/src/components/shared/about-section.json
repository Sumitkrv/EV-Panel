{
    "collectionName": "components_shared_about_sections",
    "info": {
        "displayName": "About Section",
        "description": "A section for the about page with icon, title, description and image"
    },
    "options": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "description": {
            "type": "text",
            "required": true
        },
        "icon": {
            "type": "enumeration",
            "enum": ["Target", "Zap", "Users", "Award"],
            "default": "Target",
            "required": true
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": ["images"]
        }
    }
}
