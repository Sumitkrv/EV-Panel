{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About",
    "description": "About page content with hero, sections and CTA"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "About the strapi blog"
    },
    "heroSubtitle": {
      "type": "string",
      "default": "Pioneering Sustainable"
    },
    "heroTitle": {
      "type": "string",
      "default": "Urban Mobility"
    },
    "heroDescription": {
      "type": "text",
      "default": "Leading India's transition to electric mobility through innovative technology, sustainable practices, and customer-centric solutions."
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.about-section"
    },
    "ctaTitle": {
      "type": "string",
      "default": "Ready to Make the Switch?"
    },
    "ctaDescription": {
      "type": "text",
      "default": "Experience the difference. Join thousands who've already chosen a cleaner, smarter way to commute."
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
